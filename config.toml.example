# cryptomeria-marketdata configuration
# See cryptomeria-ingest README for fallback/alias details.
#
# Environment variables:
# The app automatically loads a .env file at startup (if present).
# Place secrets such as BITVAVO_API_KEY and BITVAVO_API_SECRET in .env
# (which is git-ignored) instead of config.toml. Config.toml values
# take precedence over environment variables.
#
# Each exchange can configure multiple instruments under
# [source.<exchange>.instrument.<alias>]. The <alias> key doubles as
# the fallback lookup key into [source.<exchange>.fallback.<alias>].
# See docs/adr/Core Architecture/ADR-014-... for details.

# OKX

[source.okx]
# Region: "global" or "europe" (affects WS/REST endpoints)
region = "europe"
# Data to subscribe to: "lob", "trade", "both", or "lob|trade"
data_kind = "both"

[source.okx.instrument.btcusd]
# Instrument symbol in exchange-native format
#   OKX:      "BTC-USDT",  Kraken: "XBT/USD",  Bitstamp: "BTC/USD"
instrument = "btcusd"
# Optional suffix to override the normalized instrument name in NNG
# topic names. When set, topics use `{kind}__{suffix}` verbatim
# (no normalization), enabling cross-exchange disambiguation since
# the exchange is NOT part of the topic. Leave empty/commented to
# use the normalized instrument (e.g. `btcusd` from `BTC-USDT`).
suffix_topic = "btcusd"
# Max number of price levels per side (None = no limit)
max_level = 3
# Max percentage from best price (0.0 = no limit; conflicts with max_level)
max_level_pct = 0.0
# When true, emit a warning log on checksum mismatch (in
# addition to the always-set checksum_failed flag). When false (default),
# a mismatch is only logged at DEBUG level. Prevents an exchange feed
# from injecting log lines that interpolate an exchange-controlled value.
# checksum_log = true
# Number of diff-order-book deltas to buffer before fetching the REST
# snapshot (Bitstamp delta-buffering pattern, CCXT Pro). Default 6.
# Set to 0 to disable delta buffering (fetch snapshot immediately).
# See ADR-026 in cryptomeria-ingest.
# snapshot_delay = 6

[source.okx.resilience]
# Initial backoff in milliseconds
initial_backoff_ms = 1000
# Maximum backoff between reconnect attempts
max_backoff_ms = 60000
# Backoff multiplier per attempt
backoff_multiplier = 2.0
# Random jitter in milliseconds added to each backoff
jitter_ms = 1000
# Application-level heartbeat interval in seconds (0 = disabled; Kraken)
heartbeat_interval_secs = 0
# Max reconnect attempts (0 = unlimited)
max_attempts = 0
# Silence timeout in seconds. If no messages are received from the
# WebSocket for this duration, the connection is treated as failed
# and reconnected. 0 or omitted = no silence detection.
# silence_timeout_secs = 30

# Optional: instrument symbol fallback. See cryptomeria-ingest README.
# The structure is: within source.okx, fallback is keyed by instrument alias.
#
# [source.okx.fallback.btcusd]
# base_mappings = ["BTC", "XBT"]
# quote_mappings = ["USDC", "USDT", "USD"]
# separator_mappings = ["-", "/"]
# case_fallback = "upper"
#
# Example: instrument "btc/usdt" first tries "BTC/USDT", then
# "BTCUSDT-USDT", "BTC-USD", "XBT-USDT", etc. until one is accepted by OKX.

# When more than one exchange is configured, each runs in its own parallel
# stream and publishes to the shared NNG broker. Topics are keyed by
# `{type}__{instrument}` only (the exchange is NOT part of the topic), so use
# distinct instruments per exchange to avoid collisions.
#

# Kraken

[source.kraken]
region = "global"
data_kind = "both"

[source.kraken.instrument.btcusd]
instrument = "btcusd"
suffix_topic = "btcusd"
max_level = 3
max_level_pct = 0.0
# Number of diff-order-book deltas to buffer before fetching the REST
# snapshot (Bitstamp delta-buffering pattern, CCXT Pro). Default 6.
# Set to 0 to disable delta buffering (fetch snapshot immediately).
# See ADR-026 in cryptomeria-ingest.
# snapshot_delay = 6
# checksum_log = true

[source.kraken.resilience]
initial_backoff_ms = 1000
max_backoff_ms = 60000
backoff_multiplier = 2.0
jitter_ms = 1000
heartbeat_interval_secs = 10
max_attempts = 0
# Silence timeout in seconds. If no messages are received from the
# WebSocket for this duration, the connection is treated as failed
# and reconnected. 0 or omitted = no silence detection.
# silence_timeout_secs = 30

[source.kraken.fallback.btcusd]
base_mappings = ["BTC", "XBT"]
quote_mappings = ["USDC", "USDT", "USD"]
separator_mappings = ["-", "/", ""]
case_fallback = "upper"

